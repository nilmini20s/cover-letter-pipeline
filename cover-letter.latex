% Pandoc LaTeX template for cover letters
% Styled to match Nilmini Abeyratne's resume
% Usage: pandoc cover-letter.md -o cover-letter.pdf --template=cover-letter.latex

\documentclass[letterpaper,11pt]{article}

\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{fontawesome5}
\usepackage[default]{sourcesanspro}
\usepackage[margin=1in]{geometry}
\usepackage{parskip}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancyfoot[C]{\footnotesize\textit{This letter was authored in Markdown and built to PDF with Pandoc and a custom \LaTeX\ template. Source: \href{https://github.com/nilmini20s/cover-letter-pipeline}{github.com/nilmini20s/cover-letter-pipeline}}}

\urlstyle{same}
\raggedbottom
\raggedright

% XeLaTeX handles Unicode natively — no pdfgentounicode needed

\begin{document}

%----------HEADING----------
\begin{center}
    {\Huge \scshape $name$} \\ \vspace{5pt}
    \small
    {\raisebox{-0.2\height}\faEnvelope\ \underline{$email$}} ~
    \raisebox{-0.1\height}\faPhone\ $phone$ ~
    \raisebox{-0.15\height}\faMapMarker\ $location$ ~ \\
    \vspace{5pt}
    \href{$linkedin-url$}
    {\raisebox{-0.2\height}\faLinkedin\ \underline{$linkedin-display$}} ~
    \href{$portfolio-url$}
    {\raisebox{-0.2\height}\faGlobe\ Portfolio - \underline{$portfolio-display$}}
\end{center}

\vspace{10pt}

%----------DATE AND RECIPIENT----------
\noindent $date$ \\

\vspace{5pt}

$if(hiring-manager)$
\noindent $hiring-manager$ \\
$endif$
$if(hiring-manager-title)$
\noindent $hiring-manager-title$ \\
$endif$
\noindent $company$ \\
$if(company-address)$
\noindent $company-address$ \\
$endif$
$if(company-city)$
\noindent $company-city$ \\
$endif$

\vspace{10pt}

%----------BODY----------
$body$

\vspace{10pt}

%----------CLOSING----------
\noindent Sincerely, \\
\noindent $name$

\end{document}
